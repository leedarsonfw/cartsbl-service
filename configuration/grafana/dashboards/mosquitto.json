{
  "__elements": {},
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "9.0.5"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "Prometheus"
        },
        "options": [],
        "refresh": 1,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Exporter status",
      "id": 1,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "up{job=\"emqx\"} or up{job=\"mosquitto-exporter\"}", "refId": "A" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["last"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Clients connected",
      "id": 2,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "emqx_connections_count{job=\"emqx\"} or broker_clients_connected{job=\"mosquitto-exporter\"}", "refId": "A" }
      ],
      "options": { "reduceOptions": { "calcs": ["last"] } }
    },
    {
      "type": "stat",
      "title": "Seconds since last update",
      "id": 3,
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "(time() - timestamp(up{job=\"emqx\"})) or (time() - timestamp(broker_uptime{job=\"mosquitto-exporter\"}))", "refId": "A" }
      ],
      "options": { "reduceOptions": { "calcs": ["last"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "red", "value": 120 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Uptime",
      "description": "集群(EMQX)模式 EMQX 不暴露进程 uptime 指标，显示宿主机 uptime (node_boot_time_seconds) 作为近似",
      "id": 4,
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "(time() - process_start_time_seconds{job=\"emqx\"}) or broker_uptime{job=\"mosquitto-exporter\"} or (time() - node_boot_time_seconds{job=\"node-exporter\"})", "refId": "A" }
      ],
      "options": { "reduceOptions": { "calcs": ["last"] } },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 0 }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Messages received / sent (per second)",
      "id": 10,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "rate(emqx_messages_received{job=\"emqx\"}[5m]) or rate(broker_messages_received{job=\"mosquitto-exporter\"}[5m])", "legendFormat": "received", "refId": "A" },
        { "expr": "rate(emqx_messages_sent{job=\"emqx\"}[5m]) or rate(broker_messages_sent{job=\"mosquitto-exporter\"}[5m])", "legendFormat": "sent", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Publish messages received / sent / dropped (per second)",
      "id": 11,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "rate(emqx_packets_publish_received{job=\"emqx\"}[5m]) or rate(broker_publish_messages_received{job=\"mosquitto-exporter\"}[5m])", "legendFormat": "pub received", "refId": "A" },
        { "expr": "rate(emqx_packets_publish_sent{job=\"emqx\"}[5m]) or rate(broker_publish_messages_sent{job=\"mosquitto-exporter\"}[5m])", "legendFormat": "pub sent", "refId": "B" },
        { "expr": "rate(emqx_messages_dropped{job=\"emqx\"}[5m]) or rate(broker_publish_messages_dropped{job=\"mosquitto-exporter\"}[5m])", "legendFormat": "pub dropped", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Bytes received / sent (per second)",
      "id": 12,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "rate(emqx_bytes_received{job=\"emqx\"}[5m]) or rate(broker_bytes_received{job=\"mosquitto-exporter\"}[5m])", "legendFormat": "received", "refId": "A" },
        { "expr": "rate(emqx_bytes_sent{job=\"emqx\"}[5m]) or rate(broker_bytes_sent{job=\"mosquitto-exporter\"}[5m])", "legendFormat": "sent", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Publish bytes received / sent (per second)",
      "id": 13,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "rate(emqx_bytes_received{job=\"emqx\"}[5m]) or rate(broker_publish_bytes_received{job=\"mosquitto-exporter\"}[5m])", "legendFormat": "pub received", "refId": "A" },
        { "expr": "rate(emqx_bytes_sent{job=\"emqx\"}[5m]) or rate(broker_publish_bytes_sent{job=\"mosquitto-exporter\"}[5m])", "legendFormat": "pub sent", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Clients total / maximum",
      "id": 14,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "emqx_connections_count{job=\"emqx\"} or broker_clients_total{job=\"mosquitto-exporter\"} or vector(0)", "legendFormat": "clients total", "refId": "A" },
        { "expr": "emqx_connections_max{job=\"emqx\"} or broker_clients_maximum{job=\"mosquitto-exporter\"} or vector(0)", "legendFormat": "clients maximum", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Exporter health",
      "id": 15,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "up{job=\"emqx\"} or up{job=\"mosquitto-exporter\"}", "legendFormat": "prom scrape up", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "min": 0, "max": 1 }, "overrides": [] }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 37,
  "style": "dark",
  "tags": ["mosquitto", "emqx", "mqtt"],
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "MQTT Broker",
  "uid": "mosquitto",
  "version": 1,
  "weekStart": ""
}

